// StockTell 数据库 schema(Prisma)
// 底层 Postgres = Vercel Postgres(Neon)。Vercel 会把连接串自动注入项目环境变量。
// POSTGRES_PRISMA_URL = 连接池(pgbouncer,运行时用);
// POSTGRES_URL_NON_POOLING = 直连(给 prisma migrate / db push 用)。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  // 订阅时快照的自选(免登录 D1 个性化用):runWebPush 据此把广播标题换成
  // 「你的 XX 出现在今天的传导链」。匿名订阅,只存 codes 不存身份。
  codes     String[] @default([]) @map("codes")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model User {
  id                  String    @id @default(cuid())
  email               String?   @unique
  passwordHash        String?   @map("password_hash")
  nickname            String?
  avatar              String?
  weixinOpenId        String?   @unique @map("weixin_open_id")
  // 扫码了但还没发消息激活的时间戳;激活/解绑时清空。用于站内"还差一步"提醒 + 后台统计。
  weixinPendingScanAt DateTime? @map("weixin_pending_scan_at")
  // 退订每日邮件推送:邮件里"取消推送"按钮(带签名)点击后置 true,盘前 digest 跳过。
  digestOptOut        Boolean   @default(false) @map("digest_opt_out")
  // 关闭盘中异动提醒(默认开);仅对已绑微信用户有意义。
  intradayOptOut      Boolean   @default(false) @map("intraday_opt_out")
  // 关闭雷区提醒(解禁/增减持/质押/ST,默认开)
  riskOptOut          Boolean   @default(false) @map("risk_opt_out")
  createdAt           DateTime  @default(now()) @map("created_at")
  // 最近一次登录时间:每次成功登录由 NextAuth events.signIn 更新(JWT 模式无 Session 表,故显式记录)
  lastLoginAt         DateTime? @map("last_login_at")

  @@map("users")
}

// 雷区提醒去重:同一用户·同一事件(eventKey)只推一次。
model EventAlert {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  eventKey  String   @map("event_key") // 类型:code:关键日 等
  date      String // 推送日 YYYY-MM-DD(北京)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, eventKey])
  @@index([userId])
  @@map("event_alert")
}

// 盘中异动提醒去重:同一用户·同一票·同一天最多提醒一次。
model IntradayAlert {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  code      String
  date      String // YYYY-MM-DD(北京)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, code, date])
  @@index([userId, date])
  @@map("intraday_alert")
}

model WeixinBindToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("weixin_bind_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

model BriefingItem {
  id            String   @id @default(uuid())
  date          String // YYYY-MM-DD
  impact        String // 高 / 中 / 低
  title         String
  triggerCode   String?  @map("trigger_code")
  triggerName   String?  @map("trigger_name")
  triggerChange Float?   @map("trigger_change") // 触发美股当时涨跌%,记账判方向用
  beneficiaries Json     @default("[]")
  retailTake    String   @map("retail_take")
  sourceUrl     String?  @map("source_url")
  status        String   @default("draft") // draft / published
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([date, status])
  @@map("briefing_items")
}

// 简报记账:每条简报的受益股,在简报当日收盘后回填实际表现,等用户查账。
// 判命中规则透明:触发美股涨→期待A股涨,跌→期待A股跌;同向且|涨跌|≥阈值记 hit。
model BriefingOutcome {
  id          String   @id @default(cuid())
  briefingId  String   @map("briefing_id")
  date        String // 简报日 YYYY-MM-DD
  title       String // 冗余简报标题,查账页直接展示
  impact      String // 高 / 中 / 低
  code        String // 受益 A 股代码
  name        String // 受益 A 股名称
  expected    String // "涨" / "跌",来自触发美股方向
  change      Float? // 评估日(简报当日收盘)A股实际涨跌%
  hit         Boolean? // 是否跟上;null = 当时取不到行情
  isBacktest  Boolean  @default(false) @map("is_backtest") // true=历史回测(明牌),非实盘喊单
  evaluatedAt DateTime @default(now()) @map("evaluated_at")

  @@unique([briefingId, code])
  @@index([date])
  @@index([isBacktest])
  // 战绩页分页/统计的主查询:where isBacktest + orderBy date —— 复合索引免全表扫
  @@index([isBacktest, date])
  @@map("briefing_outcomes")
}

// 我的自选/持仓:只存 code(成本/持股二期再说)。游客走 localStorage,登录用户落这张表。
model Watchlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  code      String // 关联 STOCK_MAP 的 code
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, code])
  @@index([userId])
  @@map("watchlist")
}

// 「为什么动」全局缓存:按 code+date 存检索+总结结果(含来源摘要),避免重复打博查/LLM。
// reason 为 null 也缓存(带 updatedAt 控制重试),避免对"确实没新闻"的标的反复检索。
model WhyCache {
  code          String
  date          String
  reason        String?
  asOf          String?  @map("as_of")
  sourceUrl     String?  @map("source_url")
  sourceTitle   String?  @map("source_title")
  sourceSummary String?  @map("source_summary")
  sourceSite    String?  @map("source_site")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([code, date])
  @@map("why_cache")
}

// 「散户怎么想·详细解读」缓存:按简报条目 id 存一次,点击即取/生成,避免重复打 LLM。
model DeepAnalysisCache {
  briefingId String   @id @map("briefing_id")
  content    String
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("deep_analysis_cache")
}

// 资金面按日缓存:某交易日全市场 主力净流入/龙虎榜/融资余额 的整包(data),
// 每天首个请求拉一次 Tushare 大表落库,之后跨实例秒回(原 unstable_cache 不跨实例持久)。
// Market Intent 每日快照(2.2.2):板块指标 + 意图判定按日留痕,Track 回看与 Chain Timeline 的地基。
model MarketIntentDaily {
  ymd       String // 交易日 YYYYMMDD
  segment   String // segments.ts 的 segment key
  data      Json // { metrics: SegmentDayMetrics, intent: MarketIntent }
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([ymd, segment])
  @@index([segment, ymd])
  @@map("market_intent_daily")
}

// Daily Judgment 按日存档(2.2.5):链级三输入合成判断,yesterday→today diff(2.2.6)的数据底。
model DailyJudgment {
  ymd       String // 交易日 YYYYMMDD
  subject   String // 链 slug(后续可扩 stock code)
  data      Json // ChainJudgment
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([ymd, subject])
  @@index([subject, ymd])
  @@map("daily_judgments")
}

model FundDayCache {
  ymd       String   @id // 交易日 YYYYMMDD
  data      Json // { mf: {code:净流入亿}, lh: {code:{net,reason}}, mg: {code:融资余额亿} }
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("fund_day_cache")
}

// 个性化早报每日缓存:key = 当天日期 + 自选组合 hash;同自选同一天只生成一次。
model MorningBriefCache {
  key       String   @id
  brief     String
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("morning_brief_cache")
}

// 早报每用户当日发送记录:补发只补没发过的、重跑幂等;也是看门狗"邮件流程当天跑过"的证据。
model DigestSendLog {
  id     String   @id @default(cuid())
  date   String // YYYY-MM-DD(北京)
  userId String   @map("user_id")
  mode   String // digest | alerts
  sentAt DateTime @default(now()) @map("sent_at")

  @@unique([date, userId])
  @@index([date])
  @@map("digest_send_log")
}

// 其他产业链「我想要」投票:收集用户最想先看哪条链(去重:一人一链一票)。
model ChainInterest {
  id        String   @id @default(cuid())
  chain     String // 产业链 key
  voter     String // 投票人(登录 userId 或游客 clientId)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([chain, voter])
  @@index([chain])
  @@map("chain_interest")
}

// 行情缓存:行情接口成功时写最新一份,断连/休市时读它(标注"截至几号"),避免给用户空白。
model QuotesCache {
  id        String   @id @default("latest")
  data      Json // Record<code, {price,change,asOf}>
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("quotes_cache")
}

// 接口监控:按(路由,日期 Asia/Shanghai)聚合调用次数/累计耗时/峰值/错误/慢响应。
// 不存每条调用,只增量聚合,行数有界。后台 /admin/metrics 读它出每日调用次数与平均/峰值响应。
model ApiMetric {
  route     String
  ymd       String // Asia/Shanghai YYYYMMDD
  count     Int      @default(0)
  sumMs     Int      @default(0) @map("sum_ms") // 累计耗时(ms),avg = sumMs/count
  maxMs     Int      @default(0) @map("max_ms") // 当日峰值耗时
  errors    Int      @default(0) // 非 2xx / 抛错次数
  slow      Int      @default(0) // 超过慢阈值(API_SLOW_MS)次数
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([route, ymd])
  @@map("api_metric")
}

// 用户反馈(问题/建议/其他)。游客也可提,userId/email 可空。
model Feedback {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String?
  category  String   @default("其他")
  content   String
  path      String? // 提交时所在页面
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("feedback")
}

// insight 生产管线(PRD docs/prd-insight-pipeline.md §4):链级每日推理/事件专篇。
// status: draft → published(同链同日同 kind 至多一个,旧 published 置 superseded)| rejected | superseded
model InsightDoc {
  id          String    @id @default(uuid())
  slug        String    @unique // daily-{chainId}-{date} | evt-{date}-{triggerCode}
  chainId     String    @map("chain_id")
  date        String // YYYY-MM-DD(北京)
  kind        String // daily | event
  status      String    @default("draft") // draft | published | rejected | superseded
  payload     Json // DailyInsightPayload(daily)/ InsightChain 子集(event)
  guard       Json? // 护栏结果 {blockers, warnings, detail},审核页展示
  reviewNote  String?   @map("review_note")
  reviewedAt  DateTime? @map("reviewed_at")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([date, status])
  @@index([chainId, date, kind])
  @@map("insight_docs")
}

// 分享短链(2.3 P0-3 裂变一张卡实验,viral-growth-plan §6):自建短链+归因。
// target 只允许站内路径(创建侧强制,防开放跳转);落地写 st_ref cookie 30 天。
// 每 (cardType, date) 一条(全量同款卡共用一链,不与 userId joinable——方案 §8.7 隐私红线)。
model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique // 短码(crypto 随机 base36)
  target    String // 站内路径(以 / 开头)
  cardType  String   @map("card_type") // sentiment | stock(P1)
  date      String // YYYY-MM-DD(北京)
  hits      Int      @default(0) // 302 次数(粗归因;精确漏斗看 Umami share_link_visit)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cardType, date])
  @@map("short_links")
}

// 验证点跟踪·轻量版(2.3 P1-3):用户关注某只票的某个验证点(如「800G/1.6T 订单」)。
// 进展=结构化匹配(该票当日被事件点名),零 LLM;无进展不打扰(反焦虑)。
// 登录用户落库(游客走 localStorage,登录时合并,与 watchlist 同构)。
model VerifyFollow {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  code      String // 股票代码
  point     String // 验证点原文(来自核定关系档 verificationPoints/环节模板,非用户自填)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, code, point])
  @@index([userId])
  @@index([code])
  @@map("verify_follows")
}

// 池外票登记(2.3 P1-2):用户加了不在股池里的 A 股 → 登记为扩池需求信号。
// miss 本身变成选题探测器:admin/metrics 按 count 排序看该先收录谁;
// 纳入后 notifiedAt 记录兑现推送(「你之前加的 XX 已纳入」),登记过的期待必须兑现。
model PoolRequest {
  code       String    @id // A 股 6 位代码
  count      Int       @default(1) // 被加自选次数(登录+游客,client 上报)
  firstSeen  DateTime  @default(now()) @map("first_seen")
  lastSeen   DateTime  @updatedAt @map("last_seen")
  notifiedAt DateTime? @map("notified_at") // 纳入兑现推送完成时间

  @@map("pool_requests")
}

// 层③ relationReviewQueue 持久化(2.1-W3,2026-07-07 拍板):多次命中/复盘高频未验证的
// 关系进队列待人工沉淀。不变量#4:队列【绝不】自动改 staticRelations——confirmed 只是
// 人工结论记录,改档仍走 chain-relations.ts 代码评审。
model RelationReview {
  id            String   @id @default(uuid())
  code          String // 股票代码
  chainId       String   @map("chain_id")
  suggestedType String?  @map("suggested_type") // 建议档位(可空,人工判)
  reason        String? // 进队原因(如「近10次复盘仅验证1次」)
  source        String // outcome-review | daily-signal | manual
  hitCount      Int      @default(1) @map("hit_count") // 累计触发次数
  firstSeen     String   @map("first_seen") // YYYY-MM-DD
  lastSeen      String   @map("last_seen")
  status        String   @default("pending") // pending | confirmed | rejected
  note          String? // 人工审阅备注(仅审计,不上前台=不变量#5)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // 四轮 review V1:按源分账——同 (code,chainId) 不同 source 各自一行,幂等/hitCount/reason
  // 全部行内自洽,跨源污染在结构上不可能(此前字符串拼接+共享 lastSeen 被证出三个洞)。
  @@unique([code, chainId, source])
  @@index([status, lastSeen])
  @@map("relation_review_queue")
}

// 情境式追问(PRD prd-trust-chat-pro-intent §5,PR4):消息留存 + DB 配额计数。
// 单表即「等价表」:threadKey 归组(user:slug:date|latest:anchorType:anchorId)。
// 配额=按 user 当日 user-role 消息计数(Postgres 计数,多实例一致——【不能】用进程内 rate-limit);
// 并发 1=最新 user 消息未获回复且未超时则拒新问。content:user=原问题,assistant=GroundedAnswer JSON。
// 隐私(review P1):原问题只落本表,留存 30 天(briefing-watchdog sweepCaches 自动清,
// 口径同 /privacy「情境式追问」节);绝不进 Umami/日志响应体;提前删除走隐私政策联系渠道。
model ChatMessage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  threadKey   String   @map("thread_key")
  insightSlug String   @map("insight_slug")
  date        String? // 归档页锚定日期;最新页为 null
  anchorType  String   @map("anchor_type") // judgment | risk | hop | heat | mapping
  anchorId    String   @map("anchor_id")
  role        String // user | assistant
  content     String
  result      String? // assistant: grounded | no_evidence | redirected
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([threadKey, createdAt])
  @@map("chat_message")
}
